# Choose one provider: gigachat, openai, openai_compatible, openrouter,
# openrouter_gpt, openrouter_claude, openrouter_gemini,
# openrouter_deepseek, or openrouter_qwen.
LLM_PROVIDER=openrouter
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=virtual-patient-simulator
OPENROUTER_MODEL_DEFAULT=openai/gpt-4o-mini
OPENROUTER_MODEL_GPT=openai/gpt-4o-mini
OPENROUTER_MODEL_CLAUDE=anthropic/claude-3.5-sonnet
OPENROUTER_MODEL_GEMINI=google/gemini-1.5-pro
OPENROUTER_MODEL_DEEPSEEK=deepseek/deepseek-chat
OPENROUTER_MODEL_QWEN=qwen/qwen-2.5-72b-instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Any OpenAI-compatible endpoint
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama-3.1-8b-instruct

# GigaChat
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_CHAT_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=1
GIGACHAT_CA_BUNDLE=
GIGACHAT_RQUID=

# RAVR verification and repair
RAVR_ENABLE_RETRIEVAL=1
RAVR_REQUIRE_VALID_CITATIONS=1
RAVR_ENABLE_REPAIR=1

# Optional state-sensitive RAVR-S extension
RAVRS_ENABLE=0
RAVRS_K=3
RAVRS_MIN_SCORE=1.8
RAVRS_CANDIDATE_TEMPERATURE=0.8
RAVRS_EVAL_TEMPERATURE=0.2
RAVRS_FORCE_PROTOCOL_PARITY=0
RAVRS_ALWAYS_REPAIR=0
